<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The ONLY permission Spendly requests. Asked at the moment voice entry is first used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Microphone is optional: the app is fully usable without it. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Needed on Android 11+ to find the device's speech recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".SpendlyApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Spendly"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Spendly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Quick Add as a pop-up over the current app, for the volume-button shortcut, tile, widgets
          and launcher shortcuts. Own task, not in recents, transparent; finishes when Quick Add
          closes. Exported so launchers can start it from app shortcuts; it honours only the two
          fixed Quick Add actions and ignores extras and data, like MainActivity.
        -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Spendly.QuickAdd" />

        <!-- Only the system (holding BIND_QUICK_SETTINGS_TILE) can bind to this service. -->
        <service
            android:name=".QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Optional "Add expense" app-list entry for phone gestures that can only open an app
          (back tap, side-key double press). Disabled until switched on in Settings → Shortcuts.
          No UI, ignores its intent; own empty task affinity so it never joins Spendly's task.
        -->
        <activity
            android:name=".shortcut.QuickAddLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/tile_label"
            android:icon="@mipmap/ic_launcher_add"
            android:roundIcon="@mipmap/ic_launcher_add"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          No accessibility service, notification listener or SMS permission here: Google Play
          Protect blocks apps that declare any of them from being installed from a browser,
          messaging app or file manager in some markets. The optional volume-button shortcut (an
          accessibility service) is declared only in the volumeShortcut build:
          src/volumeShortcut/AndroidManifest.xml. ManifestPolicyTest guards this.
        -->

        <!--
          Home-screen widgets. Providers must be exported to receive APPWIDGET_UPDATE, which only the
          system can send. They show data from the encrypted database; nothing is stored for them.
        -->
        <receiver
            android:name=".widget.QuickAddWidget"
            android:exported="true"
            android:label="@string/widget_quick_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>
        <receiver
            android:name=".widget.MonthlyWidget"
            android:exported="true"
            android:label="@string/widget_monthly_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monthly_info" />
        </receiver>
        <receiver
            android:name=".widget.AccountsWidget"
            android:exported="true"
            android:label="@string/widget_accounts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_accounts_info" />
        </receiver>
        <receiver
            android:name=".widget.TrendWidget"
            android:exported="true"
            android:label="@string/widget_trend_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trend_info" />
        </receiver>
        <receiver
            android:name=".widget.StatsWidget"
            android:exported="true"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <!-- Midnight refresh for widgets (inexact alarm, no permission). Only Spendly sends it. -->
        <receiver android:name=".widget.WidgetRefreshReceiver" android:exported="false" />

        <!--
          Account widget setup. Exported because the launcher opens it; it only accepts ids of
          Spendly's own Account widgets and only chooses which account that widget shows.
        -->
        <activity
            android:name=".widget.AccountWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Spendly">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
