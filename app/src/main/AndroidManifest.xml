<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice entry. Asked at the moment voice entry is first used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Settings → Check for updates, and nothing else: only when the user taps it, MNYBOXD asks
      GitHub for its latest release and downloads MNYBOXD.apk, then hands the file to Android's
      installer (which needs REQUEST_INSTALL_PACKAGES; the user allows it once). No data is sent and
      nothing runs in the background. See AppUpdater and SECURITY.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Microphone is optional: the app is fully usable without it. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Needed on Android 11+ to find the device's speech recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!--
      hasFragileUserData: there's no account, so uninstalling deletes everything. With this flag
      Android's uninstall dialog offers to keep the app's data (Android 10+), and reinstalling
      MNYBOXD then picks up where it left off. Encrypted backups (Settings → Data management)
      remain the way to move data to another phone.
    -->
    <application
        android:name=".MnyboxdApplication"
        android:hasFragileUserData="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Mnyboxd"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mnyboxd" />

        <!--
          Quick Add as a pop-up over the current app, for the Quick Settings tile, widgets, launcher
          shortcuts and the "Add expense" icon. Own task, not in recents, transparent; finishes when Quick Add
          closes. Exported so launchers can start it from app shortcuts; it honours only its three
          fixed actions (add, speak, add income) and ignores extras and data, like MainActivity.
        -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mnyboxd.QuickAdd" />

        <!--
          The app's own entry points under the names Android and launchers knew them by before the
          app was renamed (see StableNames.kt). Keeping the names keeps the home-screen icon and
          pinned shortcuts working across the update. Each alias opens the activity above it.
        -->
        <activity-alias
            android:name="io.github.sharveshar.spendly.MainActivity"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="io.github.sharveshar.spendly.QuickAddActivity"
            android:targetActivity=".QuickAddActivity"
            android:exported="true" />

        <!-- Only the system (holding BIND_QUICK_SETTINGS_TILE) can bind to this service. -->
        <service
            android:name=".QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Optional "Add expense" app-list entry for phone gestures that can only open an app
          (back tap, side-key double press). Disabled until switched on in Settings → Shortcuts.
          No UI, ignores its intent; own empty task affinity so it never joins MNYBOXD's task.
        -->
        <activity
            android:name=".shortcut.QuickAddLauncherActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/tile_label"
            android:icon="@mipmap/ic_launcher_add"
            android:roundIcon="@mipmap/ic_launcher_add"
            android:theme="@android:style/Theme.NoDisplay" />
        <!--
          The app-list entry itself. It keeps its name from before the rename (StableNames.kt)
          because Android stores the user's on/off choice under that name.
        -->
        <activity-alias
            android:name="io.github.sharveshar.spendly.shortcut.QuickAddLauncherActivity"
            android:targetActivity=".shortcut.QuickAddLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@mipmap/ic_launcher_add"
            android:roundIcon="@mipmap/ic_launcher_add">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          No accessibility service, notification listener or SMS permission, ever: Google Play
          Protect blocks apps that declare any of them from being installed from a browser,
          messaging app or file manager in some markets (India among them). ManifestPolicyTest
          and CI guard this.
        -->

        <!--
          Home-screen widgets: Quick Add, Add income, Monthly overview and Spending trend. Providers
          must be exported to receive APPWIDGET_UPDATE, which only the system can send. They show data
          from the encrypted database; nothing is stored for them. Never rename these classes:
          Android drops placed widgets whose provider name changes.
        -->
        <receiver
            android:name=".widget.QuickAddWidget"
            android:exported="true"
            android:label="@string/widget_quick_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>
        <receiver
            android:name=".widget.AddIncomeWidget"
            android:exported="true"
            android:label="@string/widget_add_income_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_income_info" />
        </receiver>
        <receiver
            android:name=".widget.MonthlyWidget"
            android:exported="true"
            android:label="@string/widget_monthly_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monthly_info" />
        </receiver>
        <receiver
            android:name=".widget.TrendWidget"
            android:exported="true"
            android:label="@string/widget_trend_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trend_info" />
        </receiver>

        <!--
          Lets Android's installer read a downloaded update (cache/updates only), one file at a time
          through a temporary read grant. Not exported.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Midnight refresh for widgets (inexact alarm, no permission). Only MNYBOXD sends it. -->
        <receiver android:name=".widget.WidgetRefreshReceiver" android:exported="false" />

    </application>
</manifest>
