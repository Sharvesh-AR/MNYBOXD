<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background so launch never flashes white. Compose draws everything else. -->
    <style name="Theme.Spendly" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/spendly_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/spendly_accent</item>
    </style>
</resources>
