<?xml version="1.0" encoding="utf-8"?>
<!-- Spendly has no INTERNET permission and makes no network requests. This config is defence in
     depth: cleartext is forbidden and only system CAs would ever be trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
