<?xml version="1.0" encoding="utf-8"?>
<!-- MNYBOXD goes online only for Settings → Check for updates (GitHub over HTTPS; see
     AppUpdater, which also refuses hosts other than GitHub's). Cleartext is forbidden and only
     system CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
