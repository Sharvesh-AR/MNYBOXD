<?xml version="1.0" encoding="utf-8"?>
<!--
  No periodic updates (updatePeriodMillis = 0): widgets refresh when MNYBOXD's data changes and
  once after midnight. The picker preview is a picture of the real widget with illustrative
  figures (light and dark), drawn by WidgetPickerPreviews; placed widgets show only real data.
  Only previewImage, no previewLayout: with both, the widget picker on a phone running 2.7.1 listed
  every widget twice, once with an empty placeholder preview.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="560dp"
    android:maxResizeHeight="420dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_message"
    android:previewImage="@drawable/widget_preview_trend"
    android:description="@string/widget_trend_description"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
