<?xml version="1.0" encoding="utf-8"?>
<!--
  Volume-button shortcut. Deliberately minimal:
  * no accessibilityEventTypes: receives no accessibility events at all;
  * canRetrieveWindowContent="false": cannot read anything on screen;
  * the only capability is key-event filtering, used to notice volume-button presses.
  isAccessibilityTool is false because this is a convenience feature, not an assistive tool.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/button_service_description"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:isAccessibilityTool="false"
    tools:ignore="UnusedAttribute" />
