<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the volumeShortcut build only (see the productFlavors comment in app/build.gradle.kts).
  Google Play Protect blocks any app that declares an accessibility service from being installed
  from a browser, messaging app or file manager in some markets, so this build is meant for Google
  Play or `adb install`; the standard build (Spendly.apk on GitHub) leaves it out.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Optional volume-button shortcut. Inactive until the user switches it on in Android's
          Accessibility settings; only the system (BIND_ACCESSIBILITY_SERVICE) can bind to it.
          Capabilities are limited to key-event filtering (see res/xml/button_shortcut_service.xml).
          The class name is also in ShortcutSettings.BUTTON_SERVICE.
        -->
        <service
            android:name="io.github.sharveshar.spendly.shortcut.ButtonShortcutService"
            android:exported="true"
            android:label="@string/button_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/button_shortcut_service" />
        </service>
    </application>
</manifest>
